# ─────────────────────────────────────────────────────────────────
# SALUX BACKEND — Variables de entorno
# Copiá este archivo a .env y completá con tus valores reales.
# NUNCA commitees el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────

# ── Base de datos ──────────────────────────────────────────────────
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_DB
DATABASE_URL="mysql://root:CAMBIA_ESTA_CONTRASEÑA@localhost:3306/salux_db"

# ── MySQL (para docker-compose) ────────────────────────────────────
MYSQL_ROOT_PASSWORD="CAMBIA_ESTA_CONTRASEÑA"

# ── JWT ────────────────────────────────────────────────────────────
# Generá valores aleatorios con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERA_UN_STRING_ALEATORIO_DE_64_BYTES_AQUI"
JWT_REFRESH_SECRET="GENERA_OTRO_STRING_ALEATORIO_DE_64_BYTES_AQUI"

# ── Servidor ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────
# URL(s) del frontend autorizadas a consumir la API, separadas por coma.
# Si se deja vacío, se permite cualquier origen (solo recomendado en desarrollo).
CORS_ORIGIN="http://localhost:5173"

# ── Seed del Administrador inicial ─────────────────────────────────
# Usados SOLO por el script crearAdmin.js, no en producción
ADMIN_EMAIL="admin@salux.com"
ADMIN_PASSWORD="CAMBIA_ESTA_CONTRASEÑA_ADMIN"
ADMIN_NOMBRE="Nombre Apellido"
ADMIN_DNI="00000000"
